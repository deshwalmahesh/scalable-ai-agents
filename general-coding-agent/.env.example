# ==============================================================================
# Robust Coding Agent — Configuration Template
# ==============================================================================

# Active LLM Provider: "gemini" | "openai" | "anthropic" | "vllm"
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

# --- Provider Credentials (fill in the active provider) ---
GEMINI_API_KEY=your_gemini_api_key_here

# Alternative: OpenAI
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1

# Alternative: Anthropic
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Alternative: Local vLLM / Ollama
# VLLM_API_KEY=your_vllm_api_key_here
# VLLM_BASE_URL=http://localhost:8000/v1

# --- Workspace & Execution Sandboxing ---
# Directory where the agent can read and write code (defaults to current working directory)
WORKSPACE_ROOT=.

# Execution limits
COMMAND_TIMEOUT_SECONDS=30
MAX_SUPERVISOR_ITERATIONS=5
