# --- Required ---
# How to get an API key (free): https://ai.google.dev/gemini-api/docs/api-key
# Direct: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Auth (generate a real secret for prod) ---
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_IN_PROD

# --- Environment ---
APP_ENV=dev
LOG_LEVEL=INFO

# --- Models (swap for any OpenAI-compatible provider) ---
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
CHAT_MODEL=gemini-3.1-flash-lite
EMBED_MODEL=gemini-embedding-2
EMBED_DIM=768
CHUNK_SIZE=2048
CHUNK_OVERLAP=256

# --- Infra (compose sets these; localhost defaults for bare-metal dev) ---
DATABASE_URL=sqlite+aiosqlite:///./dev.db
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333

# --- Ingestion ("queue" needs the arq worker running) ---
INGEST_EXECUTOR=inline

# --- Uploads ---
MAX_UPLOAD_MB=20
MAX_UPLOAD_FILES=10
